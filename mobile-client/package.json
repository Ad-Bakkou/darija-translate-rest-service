{
  "name": "darija-translate-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "expo start --localhost --port 8082",
    "android": "expo run:android --port 8082",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.cjs",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android"
  },
  "dependencies": {
    "expo": "58.0.24",
    "expo-clipboard": "58.0.4",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "expo-doctor": "1.21.8",
    "typescript": "6.0.3"
  }
}
